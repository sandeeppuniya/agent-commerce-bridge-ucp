{
  "info": {
    "name": "See's Candies UCP Gateway (legacy payment processor-backed)",
    "_postman_id": "c1f5d4f0-0000-4000-8000-000000000001",
    "description": "Postman collection for the See's Candies UCP 2026 gateway with legacy payment processor settlement.\n\nSequence:\n1. GET /.well-known/ucp\n2. POST /oauth/token\n3. GET /ucp/catalog\n4. POST /ucp/cart\n5. POST /ucp/checkout-sessions\n6. POST /ucp/complete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Discovery - GET /.well-known/ucp",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/.well-known/ucp",
          "host": ["{{baseUrl}}"],
          "path": [".well-known", "ucp"]
        }
      }
    },
    {
      "name": "2. Identity - POST /oauth/token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/oauth/token",
          "host": ["{{baseUrl}}"],
          "path": ["oauth", "token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('auth_token', json.auth_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Catalog - GET /ucp/catalog",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ucp/catalog",
          "host": ["{{baseUrl}}"],
          "path": ["ucp", "catalog"]
        }
      }
    },
    {
      "name": "4. Cart - POST /ucp/cart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"product_id\": \"540318\", \"quantity\": 1 },\n    { \"product_id\": \"peanut_brittle\", \"quantity\": 1 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ucp/cart",
          "host": ["{{baseUrl}}"],
          "path": ["ucp", "cart"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('cart_id', json.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Checkout Session - POST /ucp/checkout-sessions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cart_id\": \"{{cart_id}}\",\n  \"buyer\": {\n    \"name\": \"See's Shopper\",\n    \"shipping_address\": \"210 El Camino Real, South San Francisco, CA 94080\",\n    \"email\": \"shopper@example.com\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ucp/checkout-sessions",
          "host": ["{{baseUrl}}"],
          "path": ["ucp", "checkout-sessions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  var json = pm.response.json();",
              "  pm.collectionVariables.set('checkout_id', json.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Legacy Processor Finalization - POST /ucp/complete",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"checkout_id\": \"{{checkout_id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ucp/complete",
          "host": ["{{baseUrl}}"],
          "path": ["ucp", "complete"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "cart_id",
      "value": ""
    },
    {
      "key": "checkout_id",
      "value": ""
    }
  ]
}

